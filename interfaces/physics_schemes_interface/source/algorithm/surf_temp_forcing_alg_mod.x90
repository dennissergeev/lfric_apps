!------------------------------------------------------------------------------
! @brief Apply prescribed forcing to the surface temperature.

module surf_temp_forcing_alg_mod

use constants_mod,                 only: r_def, i_def, pi
use field_mod,                     only: field_type
use field_collection_mod,          only: field_collection_type
use log_mod,                       only: log_event, &
                                         LOG_LEVEL_DEBUG, &
                                         LOG_LEVEL_WARNING, &
                                         LOG_LEVEL_ERROR
use sci_field_minmax_alg_mod,      only: log_field_minmax
use timing_mod,                    only: start_timing, stop_timing, tik, LPROF
use specified_surface_config_mod,  only: surf_temp_forcing, &
                                         surf_temp_forcing_none, &
                                         surf_temp_forcing_int_flux, &
                                         internal_flux_method, &
                                         internal_flux_method_random_harmonics, &
                                         internal_flux_value, &
                                         internal_flux_forcing_wavenumber, &
                                         internal_flux_forcing_decorr_timescale, &
                                         l_internal_flux_heating, &
                                         internal_flux_heating_amplitude, &
                                         internal_flux_heating_scale_heights
use internal_flux_kernel_mod,      only: internal_flux_kernel_type
use internal_flux_heating_kernel_mod, only: internal_flux_heating_kernel_type
use jules_control_init_mod,        only: n_surf_tile
use radiation_config_mod,          only: planet_emissivity
use planet_config_mod,             only: kappa
use fs_continuity_mod,             only: W3
use mesh_mod,                      only: mesh_type
use sci_geometric_constants_mod,   only: get_latitude_fv, get_longitude_fv
use random_seed_gen_alg_mod,       only: random_seed_gen_alg
use psykal_lite_phys_mod,          only: invoke_random_harmonics_forcing_kernel_type

implicit none
private

!------------------------------------------------------------------------------
! Contained functions/subroutines
!------------------------------------------------------------------------------
public :: surf_temp_forcing_alg

contains

  !> @param[in]     radiation_fields    Fields for radiation scheme
  !> @param[in,out] surface_fields      Fields for surface scheme
  !> @param[in]     dt                  The model timestep length
  !> @param[in]     theta               Potential temperature, used only for its
  !!                                    function space (Wtheta)
  !> @param[in]     exner_in_wth        Exner pressure on Wtheta levels
  !> @param[out]    dtheta_internal_flux Potential temperature increment from
  !!                                    the random harmonics internal flux
  !!                                    forcing's vertical structure S_v(p)
  subroutine surf_temp_forcing_alg(radiation_fields, surface_fields, dt, &
                                   theta, exner_in_wth, dtheta_internal_flux)

    implicit none

    type( field_collection_type ), intent(in) :: radiation_fields
    type( field_collection_type ), intent(inout) :: surface_fields
    real( kind=r_def ), intent(in) :: dt
    type( field_type ), intent(in) :: theta
    type( field_type ), intent(in) :: exner_in_wth
    type( field_type ), intent(out) :: dtheta_internal_flux

    ! Fields unpacked from radiation and surface collections
    type( field_type ), pointer :: lw_down_surf
    type( field_type ), pointer :: sw_down_surf
    type( field_type ), pointer :: sw_up_tile
    type( field_type ), pointer :: internal_flux
    type( field_type ), pointer :: tile_temperature
    integer( tik )              :: id

    ! Fields and workspace for the random harmonics internal flux forcing
    ! (equation 6 of Showman, Tan & Zhang, 2019, ApJ, arXiv:1807.08433)
    type( field_type ), pointer :: latitude => null()
    type( field_type ), pointer :: longitude => null()
    type( mesh_type ),  pointer :: mesh => null()
    real(r_def), allocatable    :: random_phase(:)
    real(r_def), allocatable    :: raw_random(:)
    integer(i_def), allocatable, save :: ranseed(:)
    logical, save                :: l_rand_harmonics_seeded = .false.
    integer(i_def)                :: random_seed_size
    real(r_def)                  :: ar1_memory_coeff
    real(r_def)                  :: heating_ratio

    if ( LPROF ) call start_timing( id, 'surf_temp_forcing' )

      if (surf_temp_forcing /= surf_temp_forcing_none) then

        select case(surf_temp_forcing)

          case(surf_temp_forcing_int_flux)
            call log_event( 'slow_physics: Running internal heat flux forcing',&
                            LOG_LEVEL_DEBUG )

            call radiation_fields%get_field('lw_down_surf', &
                                            lw_down_surf)
            call radiation_fields%get_field('sw_down_surf', &
                                            sw_down_surf)
            call radiation_fields%get_field('sw_up_tile', sw_up_tile)

            call surface_fields%get_field('internal_flux', internal_flux)
            call surface_fields%get_field('tile_temperature', tile_temperature)

            ! Always define the (intent-out) 3D heating increment, even when
            ! l_internal_flux_heating is off, so it is safe for the caller
            ! to add it into the running theta increment unconditionally.
            call dtheta_internal_flux%initialise( &
              vector_space = theta%get_function_space() )
            call invoke( setval_c(dtheta_internal_flux, 0.0_r_def) )

            if ( internal_flux_method == internal_flux_method_random_harmonics ) then

              ! Seed the RNG once, identically on every PE (the seed depends
              ! only on the model date, not on the MPI rank), so that
              ! subsequent calls to random_number stay in lockstep across
              ! the whole domain and give a globally-consistent forcing
              ! pattern rather than one that is discontinuous at PE/panel
              ! boundaries.
              if ( .not. l_rand_harmonics_seeded ) then
                call random_seed( size=random_seed_size )
                allocate( ranseed(random_seed_size) )
                call random_seed_gen_alg( ranseed, 0_i_def )
                call random_seed( put=ranseed )
                l_rand_harmonics_seeded = .true.
              end if

              ! Latitude/longitude of the internal_flux points (cached per
              ! mesh, so this is cheap after the first call). internal_flux
              ! is itself a twod=.true. field, so its own mesh is already
              ! the 2D mesh - no mesh_collection%get_mesh(..., TWOD)
              ! conversion is needed here (cf. cos_zenith_angle in
              ! illuminate_alg_mod.x90, another twod W3 field).
              mesh => internal_flux%get_mesh()
              latitude => get_latitude_fv(W3, mesh%get_id())
              longitude => get_longitude_fv(W3, mesh%get_id())

              ! Draw a fresh random phase psi_m, uniform in [0, 2*pi), for
              ! each zonal wavenumber m = 1, internal_flux_forcing_wavenumber
              ! (new phases are drawn every call, as in the paper: "new
              ! random phases psi_m are chosen each time [equation 4] is
              ! evaluated")
              allocate( raw_random(internal_flux_forcing_wavenumber) )
              allocate( random_phase(internal_flux_forcing_wavenumber) )
              call random_number( raw_random )
              random_phase = 2.0_r_def * pi * raw_random

              ! Equation 5: AR(1) memory coefficient. internal_flux plays
              ! the role of the paper's S_h and, being a checkpointed
              ! prognostic field, already carries this Markov process'
              ! state across timesteps and restarts with no extra work.
              ar1_memory_coeff = 1.0_r_def - &
                dt / internal_flux_forcing_decorr_timescale

              ! Equations 4 and 6: evolve internal_flux towards a fresh
              ! random harmonic pattern via the AR(1) process. internal_flux_value
              ! (also used as the constant flux for internal_flux_method='uniform')
              ! doubles up as the forcing amplitude f_amp here.
              call invoke_random_harmonics_forcing_kernel_type(              &
                                        internal_flux, latitude, longitude,  &
                                        internal_flux_forcing_wavenumber,    &
                                        internal_flux_value,                 &
                                        ar1_memory_coeff,                    &
                                        random_phase )

              ! Vertical structure of the forcing, S_v(p), described just
              ! before equation 4 of Showman, Tan & Zhang (2019, ApJ,
              ! arXiv:1807.08433): apply the same random realisation that
              ! now drives internal_flux, rescaled to
              ! internal_flux_heating_amplitude, as a 3D potential
              ! temperature increment near the base of the domain, decaying
              ! to zero internal_flux_heating_scale_heights scale heights
              ! above it.
              if ( l_internal_flux_heating ) then
                if ( internal_flux_value == 0.0_r_def ) then
                  call log_event( 'slow_physics: l_internal_flux_heating '//&
                    'requires a non-zero internal_flux_value to rescale '// &
                    'from - skipping', LOG_LEVEL_ERROR )
                else if ( internal_flux_heating_scale_heights <= 0.0_r_def ) &
                  then
                  call log_event( 'slow_physics: '//                        &
                    'internal_flux_heating_scale_heights must be positive', &
                    LOG_LEVEL_ERROR )
                else
                  heating_ratio = internal_flux_heating_amplitude / &
                    internal_flux_value
                  call invoke( internal_flux_heating_kernel_type(         &
                              dtheta_internal_flux,                        &
                              exner_in_wth,                                &
                              internal_flux,                               &
                              kappa,                                       &
                              internal_flux_heating_scale_heights,         &
                              heating_ratio ) )
                end if
              end if

            end if

            call log_field_minmax( LOG_LEVEL_DEBUG, 'internal_flux', internal_flux )

            call invoke( internal_flux_kernel_type( tile_temperature, &
                                                    lw_down_surf,     &
                                                    sw_down_surf,     &
                                                    sw_up_tile,       &
                                                    internal_flux,    &
                                                    n_surf_tile,      &
                                                    planet_emissivity ) )
          case default

            call log_event( 'slow_physics: Incorrect surf_temp_forcing', &
                            LOG_LEVEL_ERROR )

        end select
      end if

    if ( LPROF ) call stop_timing( id, 'surf_temp_forcing' )

  end subroutine surf_temp_forcing_alg
end module surf_temp_forcing_alg_mod
